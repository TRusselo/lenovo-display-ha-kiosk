# Restart Kiosk Satellite once the light sensor is registered (see ks-boot-fix.sh).
# Lives in /system/etc/init, which init loads on its own: /init.rc is never touched.
#
# SELinux: init may not switch to su (avc denied { transition }). The script
# file is labelled dumpstate_exec instead, so init starts it in the dumpstate
# domain, which may already run dumpsys and am (bug reports use both):
#   chcon u:object_r:dumpstate_exec:s0 /system/bin/ks-boot-fix.sh

service ks_boot_fix /system/bin/ks-boot-fix.sh
    user root
    group root log
    disabled
    oneshot

# Hardware volume buttons -> real volume keys (see ks-volume-keys.sh).
# Long-running: init restarts it if it exits. Same dumpstate_exec label:
#   chcon u:object_r:dumpstate_exec:s0 /system/bin/ks-volume-keys.sh
service ks_volume_keys /system/bin/ks-volume-keys.sh
    user root
    group root log input
    disabled

# Speaker tuning: once Lenovo's app has loaded the amp, lower its bass boost and
# flatten its compressor (see lhk/amp.py). The file is labelled peripheralman_exec,
# so init starts it in the domain that may open the amp's I2C bus:
#   chcon u:object_r:peripheralman_exec:s0 /system/bin/ks-amp-tune
service ks_amp_tune /system/bin/ks-amp-tune
    user root
    group root
    disabled
    oneshot

# A second run once the light-sensor fix and the first run are both done (about a
# minute after boot): on one boot in seven something sent the first run SIGINT.
# It finds the amp tuned and exits, or applies the tuning. The two never overlap.
service ks_amp_tune_again /system/bin/ks-amp-tune
    user root
    group root
    disabled
    oneshot

on property:sys.boot_completed=1
    start ks_boot_fix
    start ks_volume_keys
    start ks_amp_tune

on property:init.svc.ks_boot_fix=stopped && property:init.svc.ks_amp_tune=stopped
    start ks_amp_tune_again
